    mask = df["Temperature_Unit"].str.upper() == "F"
    df.loc[mask, "Temperature"] = (
        df.loc[mask, "Temperature"] - 32
    ) * 5 / 9

df = df.dropna(subset=["PM2.5"])

df.to_csv("cleaned_station.csv", index=False)


# TASK A2.2 – NORMALISATION
df = pd.read_csv("cleaned_station.csv")

minimum = df["PM2.5"].min()
maximum = df["PM2.5"].max()

if maximum != minimum:
    df["Min_Max"] = (
        (df["PM2.5"] - minimum) /
        (maximum - minimum)
    )
else:
    df["Min_Max"] = 0

mean = df["PM2.5"].mean()
std = df["PM2.5"].std()

if std != 0:
    df["Z_Score"] = (df["PM2.5"] - mean) / std
else:
    df["Z_Score"] = 0

print("Normalised Data:")
print(df[["PM2.5", "Min_Max", "Z_Score"]])

df.to_csv("normalised_station.csv", index=False)


