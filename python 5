# TASK B1 – CLEANING PIPELINE
import csv
import io

RAW = """station,date,pm25
Adyar,2026-10-01,48
Adyar,2026-10-02,NA
Adyar,2026-10-03,
Guindy,2026-10-01,95
Guindy,2026-10-02,-5
Guindy,2026-10-03,121
Guindy,2026-10-04,1200
"""

def load_clean(text):
    rows = []
    reader = csv.DictReader(io.StringIO(text))

    for row in reader:
        value = (row.get("pm25") or "").strip()

        if value == "" or value.upper() == "NA":
            continue

        try:
            pm = float(value)
        except ValueError:
            continue

        if pm < 0 or pm > 999:
            continue

        rows.append((
            row["station"].strip(),
            row["date"].strip(),
            pm
        ))

    return rows


def min_max(values):
    if not values:
        return []

    low, high = min(values), max(values)

    if high == low:
        return [0.0 for _ in values]

    return [
        round((v - low) / (high - low), 3)
        for v in values
    ]


clean = load_clean(RAW)

print(clean)
print(min_max([pm for _, _, pm in clean]))


