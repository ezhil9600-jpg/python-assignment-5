    "Not bad, service improved."
]

for complaint in complaints:
    print(label(complaint), "|", complaint)


# TASK B4 – EXTRACTIVE SUMMARISER
import re
from collections import Counter

STOP = {
    "the", "a", "an", "is", "are", "was", "were",
    "and", "or", "to", "of", "in", "on", "from",
    "it", "this", "that"
}


def summarise(text, k=2):
    sentences = re.split(
        r'(?<=[.!?])\s+',
        text.strip()
    )

    words = re.findall(r"[a-zA-Z]+", text.lower())

    important = [
        word for word in words
        if word not in STOP
    ]

    freq = Counter(important)
    scored = []

    for index, sentence in enumerate(sentences):
        tokens = re.findall(
            r"[a-zA-Z]+",
            sentence.lower()
        )

        value = sum(
            freq[word]
            for word in tokens
            if word not in STOP
        )

        scored.append((value, index, sentence))

    chosen = sorted(
        scored,
        key=lambda x: (-x[0], x[1])
    )[:k]

    return " ".join(
        item[2]
        for item in sorted(chosen, key=lambda x: x[1])
    )


