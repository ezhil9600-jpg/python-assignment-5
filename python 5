# TASK B3.2 – PERFORMANCE COMPARISON
from datetime import datetime, timedelta
import random

def make_data(station_count):
    rows = []
    start = datetime(2026, 1, 1)

    for s in range(station_count):
        for i in range(8760):
            dt = start + timedelta(hours=i)

            rows.append((
                f"S{s:03}",
                dt.strftime("%Y-%m-%d"),
                dt.hour,
                round(random.uniform(5, 180), 2)
            ))

    return rows


def timed(label, fn):
    t0 = time.perf_counter()
    result = fn()

    print(
        label,
        "seconds:",
        round(time.perf_counter() - t0, 4)
    )

    return result


for count in (1, 12, 120):
    rows = make_data(count)

    def loop_method():
        totals = {}

        for station, day, hour, pm in rows:
            key = (station, day)
            total, n = totals.get(key, (0.0, 0))
            totals[key] = (total + pm, n + 1)

        return {
            key: total / n
            for key, (total, n) in totals.items()
        }

    timed("Python loops", loop_method)

    def pandas_method():
        frame = pd.DataFrame(
            rows,
            columns=["station", "date", "hour", "pm25"]
        )

        return frame.groupby(
            ["station", "date"]
        )["pm25"].mean()

    timed("pandas", pandas_method)

    def sql_method():
        db = sqlite3.connect(":memory:")

        db.execute("""
        CREATE TABLE aq (
            station TEXT,
            day TEXT,
            hour INT,
            pm25 REAL
        )
        """)

        db.executemany(
            "INSERT INTO aq VALUES (?, ?, ?, ?)",
            rows
        )

        result = db.execute("""
        SELECT station, day, AVG(pm25)
        FROM aq
        GROUP BY station, day
        """).fetchall()

        db.close()
        return result

    timed("SQLite", sql_method)


